diff --git a/src/server.js b/src/server.js
index 20d51af..20fdb60 100644
--- a/src/server.js
+++ b/src/server.js
@@ -30639,6 +30639,67 @@ const result =
     }
 );
 
+// ========================================
+// TANDAI SEMUA NOTIFIKASI DIBACA
+// ========================================
+
+app.patch(
+    "/api/notifications/read-all",
+    async (req, res) => {
+
+        const studentId = req.session.studentId
+            ? Number(req.session.studentId)
+            : null;
+
+        const adminId = req.session.adminId
+            ? Number(req.session.adminId)
+            : null;
+
+        if (!studentId && !adminId) {
+            return res.status(401).json({
+                success: false,
+                message: "Harus login terlebih dahulu."
+            });
+        }
+
+        try {
+            const result = await tursoDb.run(
+                `
+                    UPDATE notifications
+                    SET is_read = 1
+                    WHERE is_read = 0
+                    AND (
+                        (recipient_admin_id = ? AND ? IS NOT NULL)
+                        OR
+                        (recipient_student_id = ? AND ? IS NOT NULL)
+                    )
+                `,
+                [
+                    adminId,
+                    adminId,
+                    studentId,
+                    studentId
+                ]
+            );
+
+            return res.json({
+                success: true,
+                updatedCount: Number(result.changes || 0)
+            });
+        } catch (error) {
+            console.error(
+                "Error menandai semua notifikasi:",
+                error
+            );
+
+            return res.status(500).json({
+                success: false,
+                message: "Gagal memperbarui notifikasi."
+            });
+        }
+    }
+);
+
